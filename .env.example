# 财务私有 API 环境变量（**只配置在部署环境**，绝不提交任何真实值）
#
# 配置位置：Vercel 项目 → Settings → Environment Variables（Production / Preview）。
# 本文件仅作字段说明，不含真实值。

# --- 单用户登录口令（必填）---
# 用于 POST /api/finance/session 的登录校验；建议 16 位以上随机串。
FINANCE_PASSWORD=

# --- 会话签名密钥（必填，≥16 字符）---
# 用于签发/校验 HttpOnly 会话 Cookie；轮换即令所有既有会话失效。
# 生成：openssl rand -base64 32
FINANCE_SESSION_SECRET=

# --- 会话有效期（可选，秒；默认 28800 = 8 小时，上限 86400）---
# FINANCE_SESSION_TTL_SECONDS=28800

# --- 私有持久化（必填）---
# 在 Vercel Marketplace 接入 Upstash Redis 后自动注入；两套命名任取其一。
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
